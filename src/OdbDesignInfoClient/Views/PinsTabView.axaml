<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OdbDesignInfoClient.Core.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OdbDesignInfoClient.Views.PinsTabView"
             x:DataType="vm:PinsTabViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Filter Bar -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="Filter:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding FilterText}"
                         PlaceholderText="Search by RefDes, Pin, or Net..."
                         MinWidth="300"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Command="{Binding ClearFilterCommand}"
                        ToolTip.Tip="Clear filter"
                        MinWidth="30"
                        Margin="4,0,0,0"/>
                <Button Grid.Column="3"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#33F44336"
                BorderBrush="#FFF44336"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                ZIndex="99">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF44336" TextWrapping="Wrap"/>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsLoading}"
                Background="#80000000"
                ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading pins..."
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Pins}"
                  SelectedItem="{Binding SelectedPin}"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="RefDes" Binding="{Binding RefDes}" Width="110"/>
                <DataGridTextColumn Header="Part Name" Binding="{Binding PartName}" Width="170"/>
                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60"/>
                <DataGridTextColumn Header="Pin" Binding="{Binding PinName}" Width="80"/>
                <DataGridTemplateColumn Header="Net" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PinListItemViewModel">
                            <!-- Clickable net name: deep-links to the Nets tab -->
                            <Button Command="{Binding NavigateToNetCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2,0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding NetName}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#FF0067C0"
                                           TextDecorations="Underline"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat={}{0:F3}}" Width="90"/>
                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat={}{0:F3}}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="4" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Showing "/>
                <TextBlock Text="{Binding FilteredCount}"/>
                <TextBlock Text=" of "/>
                <TextBlock Text="{Binding TotalCount}"/>
                <TextBlock Text=" pins (X/Y are component-local, in mm)"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
