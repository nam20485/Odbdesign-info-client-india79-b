<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>OdbDesignInfoClient.Services</RootNamespace>
    <AssemblyName>OdbDesignInfoClient.Services</AssemblyName>
    <Description>Service implementations for OdbDesignInfoClient including API clients and IPC</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project References -->
    <ProjectReference Include="..\OdbDesignInfoClient.Core\OdbDesignInfoClient.Core.csproj" />
    <!-- Shared product-model library: compiles the protos (Odb.Lib.Protobuf + Odb.Grpc
         client stub) and provides the FileModel → components/nets/pins/packages/parts/drill
         reader. Referenced transitively here rather than regenerating the protos twice. -->
    <ProjectReference Include="..\OdbDesign.ProductModel\OdbDesign.ProductModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- REST API Client -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.8" />
    <PackageReference Include="Refit" Version="10.1.6" />
    <PackageReference Include="Refit.HttpClientFactory" Version="10.1.6" />

    <!-- gRPC runtime (channel creation); the generated client + protobuf types come from
         the OdbDesign.ProductModel library. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />

    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
  </ItemGroup>

</Project>
