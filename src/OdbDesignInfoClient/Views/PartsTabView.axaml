<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OdbDesignInfoClient.Core.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OdbDesignInfoClient.Views.PartsTabView"
             x:DataType="vm:PartsTabViewModel">

    <UserControl.Resources>
        <!-- Part (parent) row cells -->
        <DataTemplate x:Key="PartNumberCell" x:DataType="vm:PartRowViewModel">
            <TextBlock Text="{Binding PartNumber}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PartManufacturerCell" x:DataType="vm:PartRowViewModel">
            <TextBlock Text="{Binding Manufacturer}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PartDescriptionCell" x:DataType="vm:PartRowViewModel">
            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PartUsageCountCell" x:DataType="vm:PartRowViewModel">
            <TextBlock Text="{Binding UsageCount}" VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- Usage (child) row cells -->
        <DataTemplate x:Key="UsageRefDesCell" x:DataType="vm:PartUsageRowViewModel">
            <!-- Clickable component RefDes: deep-links to the Components tab via NavigateToComponentCommand -->
            <Button Command="{Binding NavigateToComponentCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="2,0"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding ComponentRefDes}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#FF0067C0"
                           TextDecorations="Underline"/>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Filter Bar -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="Filter:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding FilterText}"
                         PlaceholderText="Search by Part Number or Description..."
                         MinWidth="300"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Command="{Binding ClearFilterCommand}"
                        ToolTip.Tip="Clear filter"
                        MinWidth="30"
                        Margin="4,0,0,0"/>
                <Button Grid.Column="3"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#33F44336"
                BorderBrush="#FFF44336"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                ZIndex="99">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF44336" TextWrapping="Wrap"/>
        </Border>



        <!-- Loading Overlay -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsLoading}"
                Background="#80000000"
                ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading parts..."
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Hierarchical Tree Grid: Part -> Component Usages (cell templates assigned in code-behind) -->
        <TreeDataGrid Grid.Row="2"
                      x:Name="PartGrid"
                      ItemsSource="{Binding Parts}"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Row"
                      SelectionChanged="OnTreeSelectionChanged">
            <TreeDataGridHierarchicalExpanderColumn Header="Part Number"
                                                    Width="200"
                                                    ChildrenBinding="{Binding Usages, DataType={x:Type vm:PartRowViewModel}}"
                                                    IsExpandedBinding="{Binding IsExpanded, DataType={x:Type vm:PartRowViewModel}}">
                <TreeDataGridTemplateColumn/>
            </TreeDataGridHierarchicalExpanderColumn>
            <TreeDataGridTemplateColumn Header="Manufacturer" Width="150"/>
            <TreeDataGridTemplateColumn Header="Description" Width="*"/>
            <TreeDataGridTemplateColumn Header="Usage Count" Width="100"/>
        </TreeDataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Showing "/>
                <TextBlock Text="{Binding FilteredCount}"/>
                <TextBlock Text=" of "/>
                <TextBlock Text="{Binding TotalCount}"/>
                <TextBlock Text=" parts"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
