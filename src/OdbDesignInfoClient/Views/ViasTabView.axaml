<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OdbDesignInfoClient.Core.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OdbDesignInfoClient.Views.ViasTabView"
             x:DataType="vm:ViasTabViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Vias"
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#33F44336"
                BorderBrush="#FFF44336"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                ZIndex="99">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF44336" TextWrapping="Wrap"/>
        </Border>

        <!-- Honest Empty State -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsEmpty}"
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                Padding="16">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="No via data"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyMessage}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="520"/>
            </StackPanel>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsLoading}"
                Background="#80000000"
                ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading vias..."
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Vias}"
                  SelectedItem="{Binding SelectedVia}"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Net" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ViaRowViewModel">
                            <!-- Clickable net name: deep-links to the Nets tab -->
                            <Button Command="{Binding NavigateToNetCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2,0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding NetName}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#FF0067C0"
                                           TextDecorations="Underline"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Net Index" Binding="{Binding NetIndex}" Width="90"/>
                <DataGridTextColumn Header="Via Count" Binding="{Binding ViaCount}" Width="100"/>
                <DataGridTextColumn Header="Pin Count" Binding="{Binding PinCount}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="4" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total: "/>
                <TextBlock Text="{Binding TotalViaCount}"/>
                <TextBlock Text=" vias across "/>
                <TextBlock Text="{Binding NetsWithVias}"/>
                <TextBlock Text=" nets"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
