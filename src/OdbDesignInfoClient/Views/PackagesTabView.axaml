<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OdbDesignInfoClient.Core.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OdbDesignInfoClient.Views.PackagesTabView"
             x:DataType="vm:PackagesTabViewModel">

    <UserControl.Resources>
        <!-- Package (parent) row cells -->
        <DataTemplate x:Key="PackageNameCell" x:DataType="vm:PackageRowViewModel">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PackagePitchCell" x:DataType="vm:PackageRowViewModel">
            <TextBlock Text="{Binding Pitch, StringFormat={}{0:F3}}" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PackagePinCountCell" x:DataType="vm:PackageRowViewModel">
            <TextBlock Text="{Binding PinCount}" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PackageDimensionsCell" x:DataType="vm:PackageRowViewModel">
            <TextBlock Text="{Binding Dimensions}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- Usage (child) row cells -->
        <DataTemplate x:Key="UsageRefDesCell" x:DataType="vm:PackageUsageRowViewModel">
            <!-- Clickable component RefDes: deep-links to the Components tab via NavigateToComponentCommand -->
            <Button Command="{Binding NavigateToComponentCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="2,0"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding ComponentRefDes}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#FF0067C0"
                           TextDecorations="Underline"/>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="UsagePartNameCell" x:DataType="vm:PackageUsageRowViewModel">
            <TextBlock Text="{Binding PartName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.75"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Filter Bar -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="Filter:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding FilterText}"
                         PlaceholderText="Search by Package Name..."
                         MinWidth="300"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Command="{Binding ClearFilterCommand}"
                        ToolTip.Tip="Clear filter"
                        MinWidth="30"
                        Margin="4,0,0,0"/>
                <Button Grid.Column="3"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#33F44336"
                BorderBrush="#FFF44336"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                ZIndex="99">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF44336" TextWrapping="Wrap"/>
        </Border>



        <!-- Loading Overlay -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsLoading}"
                Background="#80000000"
                ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading packages..."
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Hierarchical Tree Grid: Package -> Component Usages (cell templates assigned in code-behind) -->
        <TreeDataGrid Grid.Row="2"
                      x:Name="PackageGrid"
                      ItemsSource="{Binding Packages}"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Row"
                      SelectionChanged="OnTreeSelectionChanged">
            <TreeDataGridHierarchicalExpanderColumn Header="Package Name"
                                                    Width="200"
                                                    ChildrenBinding="{Binding Usages, DataType={x:Type vm:PackageRowViewModel}}"
                                                    IsExpandedBinding="{Binding IsExpanded, DataType={x:Type vm:PackageRowViewModel}}">
                <TreeDataGridTemplateColumn/>
            </TreeDataGridHierarchicalExpanderColumn>
            <TreeDataGridTemplateColumn Header="Pitch" Width="100"/>
            <TreeDataGridTemplateColumn Header="Pins" Width="80"/>
            <TreeDataGridTemplateColumn Header="Dimensions" Width="*"/>
        </TreeDataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Showing "/>
                <TextBlock Text="{Binding FilteredCount}"/>
                <TextBlock Text=" of "/>
                <TextBlock Text="{Binding TotalCount}"/>
                <TextBlock Text=" packages"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
