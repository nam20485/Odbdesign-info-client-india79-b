<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>OdbDesignInfoClient.IntegrationTests</RootNamespace>
    <AssemblyName>OdbDesignInfoClient.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OdbDesignInfoClient.Core\OdbDesignInfoClient.Core.csproj" />
    <ProjectReference Include="..\..\src\OdbDesignInfoClient.Services\OdbDesignInfoClient.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct reference to clear the NU1903 advisories (GHSA-mggc-4xg6-vcxf,
         GHSA-q939-rpr3-3284) in the SSH.NET 2025.1.0 that Testcontainers pulls
         in transitively; 2026.0.0 is the fixed line. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Testcontainers" Version="4.12.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
