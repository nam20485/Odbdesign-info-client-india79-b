<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OdbDesignInfoClient.Core.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OdbDesignInfoClient.Views.StackupTabView"
             x:DataType="vm:StackupTabViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                           Text="Layer Stackup" 
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" 
                        Content="Refresh" 
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#33F44336"
                BorderBrush="#FFF44336"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                ZIndex="99">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF44336" TextWrapping="Wrap"/>
        </Border>



        <!-- Loading Overlay -->
        <Border Grid.Row="2" 
                IsVisible="{Binding IsLoading}"
                Background="#80000000"
                ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading stackup..." 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Layer List -->
        <ScrollViewer Grid.Row="2" Padding="8">
            <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LayerRowViewModel}">
                        <Border Margin="0,2" Padding="8"
                                CornerRadius="4"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                <!-- Stack Order -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StackOrder}"
                                           Width="28"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"
                                           FontSize="12"
                                           Margin="0,0,4,0"/>

                                <!-- Layer Color Indicator -->
                                <Border Grid.Column="1"
                                        Width="24" Height="24"
                                        CornerRadius="4"
                                        Background="{Binding TypeColor}"
                                        Margin="0,0,8,0"/>

                                <!-- Layer Name + Type / Drill span -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding DrillSpan}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               IsVisible="{Binding HasDrillSpan}"/>
                                </StackPanel>

                                <!-- Polarity -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Polarity}"
                                           VerticalAlignment="Center"
                                           Width="70"/>

                                <!-- Material -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Material}"
                                           VerticalAlignment="Center"
                                           Width="90"/>

                                <!-- Thickness -->
                                <TextBlock Grid.Column="5"
                                           Text="{Binding Thickness}"
                                           VerticalAlignment="Center"
                                           Width="70"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBlock>
                <Run Text="Total: "/>
                <Run Text="{Binding TotalLayers}"/>
                <Run Text=" layers"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
